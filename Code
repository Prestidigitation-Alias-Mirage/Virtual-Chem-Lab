function Bottle({ item, remaining }: { item: Item; remaining: number }) {
  const label = useMemo(() => {
    const canvas = document.createElement('canvas');
    canvas.width = 512; canvas.height = 320;
    const context = canvas.getContext('2d');
    if (context) {
      context.fillStyle = '#faf8ec'; context.fillRect(0, 0, 512, 320);
      context.fillStyle = item.color; context.fillRect(0, 0, 512, 42);
      context.fillStyle = '#203335'; context.textAlign = 'center';
      context.font = 'bold 96px Arial'; context.fillText(FORMULAS[item.id as Reagent], 256, 157);
      context.font = 'bold 28px Arial'; context.fillText(item.name.toUpperCase(), 256, 221, 480);
      context.font = '20px Arial'; context.fillText('SIMULATED REAGENT', 256, 273);
    }
    const texture = new THREE.CanvasTexture(canvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    return texture;
  }, [item]);
  useEffect(() => () => label.dispose(), [label]);
  return <group>
    <mesh><cylinderGeometry args={[.23, .25, .62, 18]} /><meshPhysicalMaterial color="#bed7d5" transparent opacity={.46} roughness={.2} /></mesh>
    {remaining > 0 && <mesh position={[0, -.21 + .21 * remaining / 10, 0]}><cylinderGeometry args={[.19, .21, .42 * remaining / 10, 18]} /><meshStandardMaterial color={item.color} transparent opacity={.86} /></mesh>}
    <mesh position={[0, .38, 0]}><cylinderGeometry args={[.13, .13, .18, 18]} /><meshStandardMaterial color="#e8e5da" /></mesh>
    <mesh position={[0, .01, .251]}><planeGeometry args={[.39, .245]} /><meshBasicMaterial map={label} side={THREE.DoubleSide} /></mesh>
  </group>;
}


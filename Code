export type Vessel = 'flask' | 'beaker' | 'beaker-2' | 'test-tube';
export type Reagent = 'acid' | 'alkali' | 'indicator' | 'copper' | 'silver' | 'salt' | 'bicarb';
export type Portion = Partial<Record<Reagent, number>>;
export const VESSEL_CAPACITY: Record<Vessel, number> = { flask: 12, beaker: 10, 'beaker-2': 10, 'test-tube': 5 };
export const PIPETTE_CAPACITY = 3;
const REAGENTS: Reagent[] = ['acid', 'alkali', 'indicator', 'copper', 'silver', 'salt', 'bicarb'];

export function reagentPortion(reagent: Reagent): Portion {
  return { [reagent]: 1 };
}

// Each unit represents a virtual aliquot. Sharing the average composition
// across units keeps decanting and pipette samples representative of the mixture.
export function mixPortions(contents: Portion[]): Portion[] {
  if (!contents.length) return [];
  const average: Portion = {};
  for (const reagent of REAGENTS) {
    const total = contents.reduce((sum, portion) => sum + (portion[reagent] ?? 0), 0);
    if (total > 0) average[reagent] = total / contents.length;
  }
  return Array.from({ length: contents.length }, () => ({ ...average }));
}

export function availableSpace(vessel: Vessel, contents: Portion[]): number {
  return Math.max(0, VESSEL_CAPACITY[vessel] - contents.length);
}

export type Reaction = {
  label: string;
  explanation: string;
  color: string;
  gas: boolean;
  precipitate: boolean;
  fizz: boolean;
};

// Intentionally simplified observations, not a quantitative chemistry model.
export function describeReaction(contents: Portion[]): Reaction {
  const count = (kind: Reagent) => contents.reduce((sum, portion) => sum + (portion[kind] ?? 0), 0);
  const has = (kind: Reagent) => count(kind) > .01;
  if (has('silver') && has('salt')) return {
    label: 'White precipitate',
    explanation: 'Silver and chloride ions form an insoluble solid (silver chloride).',
    color: '#dce6e2', gas: false, precipitate: true, fizz: false,
  };
  if (has('acid') && has('bicarb')) return {
    label: 'Carbon dioxide bubbling',
    explanation: 'Acid and bicarbonate release carbon dioxide gas. The bubbles are visible in the vessel.',
    color: '#edc998', gas: true, precipitate: false, fizz: true,
  };
  if (has('indicator') && has('alkali')) {
    const alkaline = count('alkali') > count('acid') + .01;
    return {
      label: alkaline ? 'Indicator turns pink' : 'Indicator turns clear',
      explanation: alkaline
        ? 'In this simplified model, phenolphthalein appears pink while the mixture is alkaline. Add acid to see it fade.'
        : 'The simulated mixture is no longer alkaline enough for phenolphthalein to stay pink.',
      color: alkaline ? '#ef6aa9' : '#e5cfda',
      gas: false, precipitate: false, fizz: false,
    };
  }
  if (has('acid') && has('alkali')) return {
    label: 'Acid and alkali mixed',
    explanation: 'The acid and alkali neutralize in this simplified model; no gas is produced by this pair.',
    color: '#b5d5ce', gas: false, precipitate: false, fizz: false,
  };
  if (has('copper')) return {
    label: 'Blue solution',
    explanation: 'Copper(II) sulfate gives the solution its characteristic blue appearance.',
    color: '#267fd2', gas: false, precipitate: false, fizz: false,
  };
  if (has('indicator')) return {
    label: 'Indicator remains clear',
    explanation: 'Phenolphthalein is clear until the simulated mixture becomes alkaline.',
    color: '#d9e3df', gas: false, precipitate: false, fizz: false,
  };
  return {
    label: contents.length ? 'Solution prepared' : 'Empty vessel',
    explanation: contents.length ? 'The reagents are mixed; no distinctive reaction is shown for this combination.' : 'Add a reagent to observe a change.',
    color: contents.length && has('acid') ? '#e5caa9' : '#8ac8c6',
    gas: false, precipitate: false, fizz: false,
  };
}

export function isRunaway(contents: Portion[], temperature: number): boolean {
  // A theatrical sandbox event for diverse mixtures heated well past the normal range.
  // It is not a claim that these real-world chemicals would explode together.
  const ingredients = REAGENTS.filter(reagent => contents.some(portion => (portion[reagent] ?? 0) > .01));
  return temperature >= 130 && ingredients.length >= 3 && contents.length >= 4;
}


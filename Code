function Player() {
  const { camera } = useThree();
  const [, get] = useKeyboardControls();
  const forward = useMemo(() => new THREE.Vector3(), []);
  const right = useMemo(() => new THREE.Vector3(), []);
  useFrame((_, delta) => {
    const keys = get() as Record<string, boolean>;
    camera.getWorldDirection(forward);
    forward.y = 0; forward.normalize();
    right.crossVectors(forward, camera.up).normalize();
    const movement = new THREE.Vector3();
    if (keys.forward) movement.add(forward);
    if (keys.back) movement.sub(forward);
    if (keys.left) movement.sub(right);
    if (keys.right) movement.add(right);
    if (movement.lengthSq() === 0) return;
    movement.normalize().multiplyScalar(Math.min(delta, .04) * (keys.sprint ? 5 : 3));
    const nextX = THREE.MathUtils.clamp(camera.position.x + movement.x, -8.1, 8.1);
    const nextZ = THREE.MathUtils.clamp(camera.position.z + movement.z, -10.5, 10.5);
    // Walk around benches, not through them. A wider central gap keeps equipment reachable.
    const blocked = (Math.abs(nextX) < 3.15 && nextZ > -3.05 && nextZ < .25)
      || (Math.abs(nextX) > 3.95 && ((nextZ > .05 && nextZ < 7.05) || (nextZ > -8.2 && nextZ < -2.6)));
    if (!blocked) camera.position.set(nextX, 1.67, nextZ);
  });
  return null;
}

function Aiming({ onTarget, targetRef }: {
  onTarget: (target: Target | null) => void;
  targetRef: React.RefObject<Target | null>;
}) {
  const { camera, scene } = useThree();
  const ray = useMemo(() => new THREE.Raycaster(), []);
  const previous = useRef('');
  useFrame(() => {
    ray.setFromCamera(new THREE.Vector2(0, 0), camera);
    ray.far = 3.3;
    const hits = ray.intersectObjects(scene.children, true);
    let found: Target | null = null;
    for (const hit of hits) {
      let object: THREE.Object3D | null = hit.object;
      while (object && !object.userData.labTarget) object = object.parent;
      if (!object) continue;
      const marked = object.userData.labTarget as { type: 'item'; id: Kind } | { type: 'bench'; bounds: [number, number, number, number] } | { type: 'hotplate' } | { type: 'waste' };
      found = marked.type === 'item'
        ? { type: 'item', id: marked.id }
        : marked.type === 'hotplate' ? { type: 'hotplate' }
          : marked.type === 'waste' ? { type: 'waste' }
          : { type: 'bench', point: [hit.point.x, BENCH_Y, hit.point.z], bounds: marked.bounds };
      break;
    }
    targetRef.current = found;
    const key = found ? found.type === 'item' ? found.id : found.type : '';
    if (key !== previous.current) { previous.current = key; onTarget(found); }
  });
  return null;
}

function HeldObject({ held, contents, sample, remaining, temperatures }: {
  held: Kind | null; contents: Record<Vessel, Portion[]>; sample: Portion[]; remaining: Record<Reagent, number>; temperatures: Record<Vessel, number>;
}) {
  const { camera } = useThree();
  const group = useRef<THREE.Group>(null);
  useFrame(() => {
    if (!group.current) return;
    group.current.position.copy(camera.position);
    group.current.quaternion.copy(camera.quaternion);
    group.current.translateX(.4);
    group.current.translateY(-.36);
    group.current.translateZ(-.85);
  });
  if (!held) return null;
  return <group ref={group} scale={.76}>
    {REAGENTS.includes(held as Reagent)
      ? <Bottle item={LOOKUP[held]} remaining={remaining[held as Reagent]} />
      : <Glassware kind={held as Vessel | 'pipette'} contents={VESSELS.includes(held as Vessel) ? contents[held as Vessel] : []} sample={sample} temperature={VESSELS.includes(held as Vessel) ? temperatures[held as Vessel] : 22} />}
  </group>;
}

function World({ positions, contents, remaining, sample, held, temperatures, hotplateOn, mishap, setHotplateOn, setActiveVessel, setPositions, setContents, setRemaining, setSample, setHeld, setMessage, setFocus }: {
  positions: Record<Kind, Position>;
  contents: Record<Vessel, Portion[]>;
  remaining: Record<Reagent, number>;
  temperatures: Record<Vessel, number>;
  hotplateOn: boolean;
  mishap: boolean;
  setHotplateOn: (value: boolean) => void;
  setActiveVessel: (value: Vessel) => void;
  sample: Portion[];
  held: Kind | null;
  setPositions: React.Dispatch<React.SetStateAction<Record<Kind, Position>>>;
  setContents: React.Dispatch<React.SetStateAction<Record<Vessel, Portion[]>>>;
  setRemaining: React.Dispatch<React.SetStateAction<Record<Reagent, number>>>;
  setSample: (value: Portion[]) => void;
  setHeld: (value: Kind | null) => void;
  setMessage: (value: string) => void;
  setFocus: (target: Target | null) => void;
}) {
  const targetRef = useRef<Target | null>(null);
  const act = useCallback((target: Target) => {
    if (mishap) { setMessage('The virtual lab needs a reset before the next experiment.'); return; }
    if (target.type === 'waste') {
      if (held === 'pipette' && sample.length) {
        setSample([]);
        setMessage(`Emptied ${sample.length} drop${sample.length > 1 ? 's' : ''} from the pipette into the virtual waste station.`);
      } else if (held && VESSELS.includes(held as Vessel)) {
        if (!contents[held as Vessel].length) { setMessage('The vessel is already empty.'); return; }
        setContents(current => ({ ...current, [held]: [] }));
        setActiveVessel(held as Vessel);
        setMessage(`${LOOKUP[held].name} emptied into the virtual waste station. The vessel is ready for another experiment.`);
      } else setMessage('Hold a filled vessel or pipette to empty it into the virtual waste station.');
      return;
    }
    if (target.type === 'hotplate') {
      if (!held) {
        setHotplateOn(!hotplateOn);
        setMessage(`Hotplate switched ${hotplateOn ? 'off' : 'on'}. Place a vessel on the plate to ${hotplateOn ? 'stop' : 'start'} heating.`);
      } else if (VESSELS.includes(held as Vessel)) {
        const occupied = VESSELS.some(id => id !== held && positions[id].location === 'bench'
          && Math.hypot(positions[id].point[0] - 1.4, positions[id].point[2] + .75) < .36);
        if (occupied) { setMessage('The hotplate is occupied.'); return; }
        const height = held === 'flask' ? .36 : held === 'test-tube' ? .32 : .31;
        setPositions(current => ({ ...current, [held]: { location: 'bench', point: [1.4, 1.26 + height, -.75] } }));
        setActiveVessel(held as Vessel);
        setHeld(null);
        setMessage(`${LOOKUP[held].name} placed on the hotplate${hotplateOn ? ' and warming' : '. Switch the plate on to heat it'}.`);
      } else setMessage('Only a flask, beaker, or test tube can go on the hotplate.');
      return;
    }
    if (target.type === 'bench') {
      if (!held) return;
      // Objects are centered on their own geometry; add the exact base-to-center offset.
      const y = BENCH_Y + (held === 'pipette' ? .12 : held === 'flask' ? .36 : held === 'test-tube' ? .32 : .31);
      const point: [number, number, number] = [
        THREE.MathUtils.clamp(target.point[0], target.bounds[0], target.bounds[1]), y,
        THREE.MathUtils.clamp(target.point[2], target.bounds[2], target.bounds[3]),
      ];
      const occupied = Object.entries(positions).some(([id, position]) =>
        id !== held && position.location === 'bench' &&
        Math.hypot(position.point[0] - point[0], position.point[2] - point[2]) < .55);
      if (occupied) { setMessage('That spot is occupied. Aim at a clear part of the worktop.'); return; }
      const fixtures: [number, number, number][] = [[1.4, -.75, .6], [0, -.75, .55], [-1.4, -.7, .64], [-6.3, 3.2, .65], [-2, -1.75, .52], [2, -1.75, .52]];
      if (fixtures.some(([x, z, radius]) => Math.hypot(point[0] - x, point[2] - z) < radius)) {
        setMessage('That spot has fixed equipment. Choose a clear area of the worktop.'); return;
      }
      setPositions(current => ({ ...current, [held]: { location: 'bench', point } }));
      setHeld(null);
      setMessage(`${LOOKUP[held].name} placed on the worktop. Aim at it and press E to pick it up again.`);
      return;
    }
    const id = target.id;
    if (!held) {
      setHeld(id);
      setPositions(current => ({ ...current, [id]: { ...current[id], location: 'held' } }));
      setMessage(`Holding ${LOOKUP[id].name}. Aim at the bench to place it.`);
      return;
    }
    if (held === 'pipette') {
      if (id === 'pipette') return;
      if (VESSELS.includes(id as Vessel) && sample.length) {
        if (!availableSpace(id as Vessel, contents[id as Vessel])) {
          setMessage(`${LOOKUP[id].name} is full. The drops remain in the pipette.`); return;
        }
        const drop = sample[sample.length - 1];
        setContents(current => ({ ...current, [id]: mixPortions([...current[id as Vessel], drop]) }));
        setActiveVessel(id as Vessel);
        setSample(sample.slice(0, -1));
        setMessage(`Dispensed one drop of ${portionNames(drop)} into ${LOOKUP[id].name}. ${sample.length - 1} / ${PIPETTE_CAPACITY} drops remain in the pipette.`);
      } else if (sample.length >= PIPETTE_CAPACITY) {
        setMessage(`Pipette is full (${PIPETTE_CAPACITY} drops). Aim at a beaker, flask, or test tube to dispense.`);
      } else if (REAGENTS.includes(id as Reagent)) {
        if (remaining[id as Reagent] <= 0) { setMessage('That bottle is empty.'); return; }
        setRemaining(current => ({ ...current, [id]: current[id as Reagent] - 1 }));
        setSample(mixPortions([...sample, reagentPortion(id as Reagent)]));
        setMessage(`Drew one drop from ${LOOKUP[id].name} (${sample.length + 1} / ${PIPETTE_CAPACITY}). Draw again or aim at a vessel to dispense.`);
      } else if (VESSELS.includes(id as Vessel)) {
        const liquid = contents[id as Vessel];
        if (!liquid.length) { setMessage('The vessel is empty.'); return; }
        const extracted = liquid[liquid.length - 1];
        setContents(current => ({ ...current, [id]: current[id as Vessel].slice(0, -1) }));
        setActiveVessel(id as Vessel);
        setSample(mixPortions([...sample, extracted]));
        setMessage(`Drew one drop of ${portionNames(extracted)} from ${LOOKUP[id].name} (${sample.length + 1} / ${PIPETTE_CAPACITY}).`);
      }
      return;
    }
    if (REAGENTS.includes(held as Reagent) && VESSELS.includes(id as Vessel)) {
      if (remaining[held as Reagent] <= 0) { setMessage('This bottle is empty.'); return; }
      const poured = Math.min(2, remaining[held as Reagent], availableSpace(id as Vessel, contents[id as Vessel]));
      if (!poured) { setMessage(`${LOOKUP[id].name} is full. Choose another vessel before pouring.`); return; }
      setRemaining(current => ({ ...current, [held]: current[held as Reagent] - poured }));
      setContents(current => ({
        ...current, [id]: mixPortions([
          ...current[id as Vessel],
          ...Array.from({ length: poured }, () => reagentPortion(held as Reagent)),
        ]),
      }));
      setActiveVessel(id as Vessel);
      setMessage(`Poured ${poured} virtual portion${poured > 1 ? 's' : ''} of ${LOOKUP[held].name} into the ${LOOKUP[id].name}. The bottle is still in your hand.`);
      return;
    }
    if (VESSELS.includes(held as Vessel) && VESSELS.includes(id as Vessel)) {
      const source = contents[held as Vessel];
      if (!source.length) { setMessage('The vessel you are holding is empty.'); return; }
      const amount = Math.min(Math.ceil(source.length / 2), availableSpace(id as Vessel, contents[id as Vessel]));
      if (!amount) { setMessage(`${LOOKUP[id].name} is full. Nothing was transferred.`); return; }
      setContents(current => ({
        ...current, [held]: current[held as Vessel].slice(0, -amount),
        [id]: mixPortions([...current[id as Vessel], ...current[held as Vessel].slice(-amount)]),
      }));
      setActiveVessel(id as Vessel);
      setMessage(`Transferred ${amount} measured portion${amount > 1 ? 's' : ''} from ${LOOKUP[held].name} to ${LOOKUP[id].name}.`);
      return;
    }
    setMessage('Place the held item on the bench first, or aim at a vessel to pour.');
  }, [contents, held, hotplateOn, mishap, positions, remaining, sample, setActiveVessel, setContents, setHeld, setHotplateOn, setMessage, setPositions, setRemaining, setSample]);

  useEffect(() => {
    const keydown = (event: KeyboardEvent) => {
      if (event.repeat) return;
      if (event.code === 'KeyE' && targetRef.current) { event.preventDefault(); act(targetRef.current); }
      if (event.code === 'KeyH' && !mishap) {
        setHotplateOn(!hotplateOn);
        setMessage(`Hotplate switched ${hotplateOn ? 'off' : 'on'}.`);
      }
      if (event.code === 'KeyQ' && held) {
        setPositions(current => ({ ...current, [held]: { location: 'shelf', point: LOOKUP[held].shelf } }));
        setHeld(null);
        setMessage(`${LOOKUP[held].name} returned to storage.`);
      }
    };
    const click = (event: MouseEvent) => {
      if (event.target instanceof HTMLCanvasElement && document.pointerLockElement === event.target && targetRef.current) {
        act(targetRef.current);
      }
    };
    window.addEventListener('keydown', keydown);
    window.addEventListener('click', click);
    return () => {
      window.removeEventListener('keydown', keydown);
      window.removeEventListener('click', click);
    };
  }, [act, held, hotplateOn, mishap, setHeld, setHotplateOn, setMessage, setPositions]);

  return <>
    <Room hotplateOn={hotplateOn} mishap={mishap} />
    {ITEMS.map(item => positions[item.id].location !== 'held' &&
      <LabObject key={item.id} item={item} point={positions[item.id].point}
        contents={VESSELS.includes(item.id as Vessel) ? contents[item.id as Vessel] : []}
        sample={item.id === 'pipette' ? sample : []}
        remaining={REAGENTS.includes(item.id as Reagent) ? remaining[item.id as Reagent] : 0}
        temperature={VESSELS.includes(item.id as Vessel) ? temperatures[item.id as Vessel] : 22} />)}
    <HeldObject held={held} contents={contents} sample={sample} remaining={remaining} temperatures={temperatures} />
    <Player />
    <Aiming onTarget={setFocus} targetRef={targetRef} />
    <PointerLockControls />
  </>;
}

function canUseWebGL(): boolean {
  try {
    const canvas = document.createElement('canvas');
    return Boolean(canvas.getContext('webgl2') || canvas.getContext('webgl'));
  } catch { return false; }
}


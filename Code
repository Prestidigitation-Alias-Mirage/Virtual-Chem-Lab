function reagentColor(contents: Portion[]): string {
  return describeReaction(contents).color;
}

function ReactionEffects({ kind, contents, temperature }: { kind: Vessel; contents: Portion[]; temperature: number }) {
  const particles = useRef<THREE.Group>(null);
  const reaction = describeReaction(contents);
  const active = reaction.fizz || (temperature > 75 && contents.length > 0);
  useFrame(({ clock }) => {
    if (!particles.current || !active) return;
    particles.current.children.forEach((child, index) => {
      child.position.y = -.22 + ((clock.elapsedTime * (reaction.fizz ? .62 : .32) + index * .17) % .58);
    });
  });
  return <>
    {reaction.precipitate && <mesh position={[0, -.3, 0]}>
      <cylinderGeometry args={[kind === 'test-tube' ? .062 : .2, kind === 'test-tube' ? .062 : .22, .07, 18]} />
      <meshStandardMaterial color="#f4f4e8" />
    </mesh>}
    {active && <group ref={particles}>
      {Array.from({ length: 7 }, (_, index) => <mesh key={index}
        position={[Math.sin(index * 3) * (kind === 'test-tube' ? .035 : .15), 0, Math.cos(index * 2) * (kind === 'test-tube' ? .03 : .13)]}>
        <sphereGeometry args={[kind === 'test-tube' ? .017 : .03, 8, 6]} />
        <meshStandardMaterial color={temperature > 85 ? '#f2f0df' : '#e9f8f6'} transparent opacity={.7} />
      </mesh>)}
    </group>}
  </>;
}

